<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane
        prefHeight="900.0"
        prefWidth="1400.0"
        styleClass="root-pane"
        stylesheets="@create-garden.css"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.geraj.assignment.controller.CreateGardenController">


    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="18"
              styleClass="top-bar">

            <Label text="●" styleClass="brand-icon"/>
            <Label text="CommunityPlant" styleClass="brand-name"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Gardens" styleClass="nav-button-active"/>
            <Button text="Calendar" styleClass="nav-button"/>
            <Button text="Account" styleClass="nav-button"/>

            <StackPane
                    minHeight="38"
                    minWidth="38"
                    prefHeight="38"
                    prefWidth="38"
                    styleClass="avatar">

                <Label text="MM" styleClass="avatar-text"/>

            </StackPane>

            <Label text="AccName" styleClass="account-name"/>

        </HBox>
    </top>


    <center>

        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="page-scroll">

            <content>

                <VBox
                        alignment="TOP_CENTER"
                        spacing="24"
                        styleClass="page-content">

                    <padding>
                        <Insets top="36" right="55" bottom="50" left="55"/>
                    </padding>


                    <!-- PAGE HEADING -->

                    <VBox
                            alignment="CENTER_LEFT"
                            maxWidth="1200"
                            spacing="8">

                        <Label
                                text="Gardens  /  Create garden"
                                styleClass="breadcrumb"/>

                        <Label
                                text="Create a new garden"
                                styleClass="page-title"/>

                        <Label
                                text="Set up the garden and its empty planter boxes. Crops can be added after the garden is created."
                                styleClass="page-description"/>

                    </VBox>


                    <!-- TWO COLUMN CONTENT -->

                    <GridPane
                            hgap="24"
                            maxWidth="1200">

                        <columnConstraints>

                            <ColumnConstraints
                                    hgrow="ALWAYS"
                                    percentWidth="70"/>

                            <ColumnConstraints
                                    hgrow="ALWAYS"
                                    percentWidth="30"/>

                        </columnConstraints>


                        <!-- ========================= -->
                        <!-- LEFT: CREATE GARDEN FORM  -->
                        <!-- ========================= -->

                        <VBox
                                GridPane.columnIndex="0"
                                GridPane.valignment="TOP"
                                spacing="14"
                                styleClass="card">

                            <Label
                                    text="Garden details"
                                    styleClass="section-title"/>

                            <Label
                                    text="Required information is marked with an asterisk."
                                    styleClass="muted-text"/>


                            <!-- GARDEN NAME -->

                            <Label
                                    text="Garden name *"
                                    styleClass="field-label"/>

                            <TextField
                                    fx:id="gardenNameField"
                                    promptText="e.g. QUT Community Garden"/>


                            <!-- LOCATION -->

                            <Label
                                    text="Location *"
                                    styleClass="field-label"/>

                            <TextField
                                    fx:id="locationField"
                                    promptText="e.g. Gardens Point"/>


                            <Separator/>


                            <!-- GARDEN LAYOUT -->

                            <Label
                                    text="Garden layout"
                                    styleClass="section-title"/>

                            <Label
                                    text="Use metres for the overall garden footprint."
                                    styleClass="muted-text"/>


                            <!-- WIDTH + LENGTH -->

                            <GridPane hgap="18" vgap="8">

                                <columnConstraints>

                                    <ColumnConstraints
                                            hgrow="ALWAYS"
                                            percentWidth="50"/>

                                    <ColumnConstraints
                                            hgrow="ALWAYS"
                                            percentWidth="50"/>

                                </columnConstraints>


                                <Label
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="0"
                                        text="Width (m) *"
                                        styleClass="field-label"/>

                                <Label
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="0"
                                        text="Length (m) *"
                                        styleClass="field-label"/>


                                <TextField
                                        fx:id="widthField"
                                        GridPane.columnIndex="0"
                                        GridPane.rowIndex="1"
                                        promptText="e.g. 12"/>

                                <TextField
                                        fx:id="lengthField"
                                        GridPane.columnIndex="1"
                                        GridPane.rowIndex="1"
                                        promptText="e.g. 8"/>

                            </GridPane>


                            <!-- PLANTER BOXES -->

                            <Label
                                    text="Number of planter boxes *"
                                    styleClass="field-label"/>

                            <Label
                                    text="Empty boxes are created when the garden is saved."
                                    styleClass="muted-text"/>

                            <TextField
                                    fx:id="planterBoxField"
                                    promptText="e.g. 6"/>


                            <!-- HIDDEN INLINE ERROR -->

                            <Label
                                    fx:id="planterErrorLabel"
                                    text="Enter at least 1 planter box."
                                    visible="false"
                                    managed="false"
                                    styleClass="field-error"/>


                            <!-- HIDDEN FORM ERROR -->

                            <VBox
                                    fx:id="formErrorBox"
                                    spacing="4"
                                    visible="false"
                                    managed="false"
                                    styleClass="error-banner">

                                <Label
                                        text="Garden not saved"
                                        styleClass="error-title"/>

                                <Label
                                        text="Fix the invalid details first. Invalid details are never stored."
                                        wrapText="true"
                                        styleClass="error-message"/>

                            </VBox>


                            <!-- BUTTONS -->

                            <HBox
                                    alignment="CENTER_RIGHT"
                                    spacing="12">

                                <padding>
                                    <Insets top="20" right="0" bottom="0" left="0"/>
                                </padding>

                                <Button
                                        fx:id="cancelButton"
                                        text="Cancel"
                                        styleClass="secondary-button"/>

                                <Button
                                        fx:id="createGardenButton"
                                        text="Create garden"
                                        styleClass="primary-button"/>

                            </HBox>

                        </VBox>


                        <!-- ========================= -->
                        <!-- RIGHT INFORMATION COLUMN  -->
                        <!-- ========================= -->

                        <VBox
                                GridPane.columnIndex="1"
                                GridPane.valignment="TOP"
                                spacing="18">


                            <!-- ADMIN PANEL -->

                            <VBox spacing="12" styleClass="card">

                                <StackPane
                                        minHeight="44"
                                        minWidth="44"
                                        prefHeight="44"
                                        prefWidth="44"
                                        styleClass="admin-icon">

                                    <Label
                                            text="✓"
                                            styleClass="admin-icon-text"/>

                                </StackPane>

                                <Label
                                        text="ORGANISER ACCESS"
                                        styleClass="eyebrow"/>

                                <Label
                                        text="You’ll become the garden admin"
                                        wrapText="true"
                                        styleClass="side-title"/>

                                <Label
                                        text="The signed-in organiser can manage garden details, planter boxes and members after creation."
                                        wrapText="true"
                                        styleClass="muted-text"/>

                            </VBox>


                            <!-- WHAT HAPPENS NEXT -->

                            <VBox spacing="12" styleClass="card">

                                <Label
                                        text="What happens next"
                                        styleClass="side-title"/>

                                <Label
                                        text="After valid details are submitted:"
                                        styleClass="muted-text"/>

                                <Label text="1   Save the garden"/>
                                <Label text="2   Create its empty planter boxes"/>
                                <Label text="3   Open the garden overview"/>

                                <Separator/>

                                <VBox
                                        spacing="5"
                                        styleClass="info-banner">

                                    <Label
                                            text="Crops stay separate"
                                            styleClass="info-title"/>

                                    <Label
                                            text="Add crops only after creation as the next US-18 task."
                                            wrapText="true"
                                            styleClass="info-text"/>

                                </VBox>

                            </VBox>


                            <!-- REQUIREMENTS -->

                            <VBox
                                    spacing="7"
                                    styleClass="requirement-card">

                                <Label
                                        text="Required before save"
                                        styleClass="requirement-title"/>

                                <Label
                                        text="Name · Location · Width · Length"/>

                                <Label
                                        text="At least 1 planter box"/>

                            </VBox>

                        </VBox>

                    </GridPane>

                </VBox>

            </content>

        </ScrollPane>

    </center>

</BorderPane>